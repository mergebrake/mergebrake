// Example Prisma schema for MergeBrake testing.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  // full_name was here; the migration drops it.
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}
