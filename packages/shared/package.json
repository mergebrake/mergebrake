{
  "name": "mergebrake-shared",
  "version": "0.0.3",
  "description": "Shared types and constants for MergeBrake packages",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run --passWithNoTests"
  },
  "license": "MIT",
  "homepage": "https://mergebrake.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mergebrake/mergebrake.git",
    "directory": "packages/shared"
  }
}
