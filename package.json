{
  "name": "mergebrake-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "MergeBrake: hit the brake before AI-generated PRs hit production. Monorepo root.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/shared packages/core packages/cli",
    "test": "vitest run",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mergebrake/mergebrake.git"
  }
}
