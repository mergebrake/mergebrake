{
  "name": "mergebrake-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "MergeBrake maps database schema changes to the application code they can break before a PR merges.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/shared packages/core packages/cli",
    "test": "vitest run",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "og:build": "node website/scripts/build-og.mjs",
    "release:prepare": "node scripts/release-prepare.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mergebrake/mergebrake.git"
  }
}
